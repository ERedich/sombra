# Backend origin (no trailing slash). Required for API calls from the app.
#
# Local dev:
# - iOS simulator / web: often http://localhost:<backend-port>
# - Android emulator: http://10.0.2.2:<backend-port> (maps to host loopback)
# - Physical device: your machine's LAN IP, e.g. http://192.168.1.10:<backend-port>
EXPO_PUBLIC_API_URL=http://localhost:3001
