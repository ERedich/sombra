# Copy to backend/.env and fill in values. Never commit real credentials.

# USER, PASSWORD — match your local or hosted Postgres (database name: sombra)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sombra
# Optional: maintenance DB to connect to before CREATE DATABASE (default: postgres)
# MAINTENANCE_DATABASE=postgres
JWT_SECRET=

# Optional: daily PM due-order generation at 17:30 (Europe/Berlin). Default off.
# GENERATE_DUE_CRON_ENABLED=true
# GENERATE_DUE_TIMEZONE=Europe/Berlin
# GENERATE_DUE_ACTOR_USER_ID=<uuid of technical user for audit created_by>

# Optional: full database copy (requires PostgreSQL client tools: pg_dump, pg_restore)
# SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sombra
# TARGET_DATABASE_URL=postgresql://user:pass@host.example/dbname?sslmode=require
# PG_DUMP=
# PG_RESTORE=
